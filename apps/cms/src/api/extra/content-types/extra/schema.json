{
  "kind": "collectionType",
  "collectionName": "extras",
  "info": {
    "singularName": "extra",
    "pluralName": "extras",
    "displayName": "Extra"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "price": {
      "type": "integer",
      "required": true
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "menus": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::menu.menu",
      "mappedBy": "extras"
    },
    "soldOut": {
      "type": "boolean",
      "default": false
    }
  }
}
